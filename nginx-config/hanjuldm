# ============================================================
# hanjulDM nginx site config
# 분리 시점: 2026-05-12 (한줄AI nginx config /etc/nginx/sites-enabled/targetup과 완전 독립)
# ============================================================
# 등록: /etc/nginx/sites-enabled/hanjuldm 으로 symlink
# 적용: sudo nginx -t && sudo systemctl reload nginx
#
# 도메인:
#   - hanjul-flyer.kr / www.hanjul-flyer.kr / hanjul-flyer.com / hanjul-flyer.co.kr — 매장 사장님
#   - admin.hanjuldm.kr / sys.hanjuldm.kr — 슈퍼관리자
#
# 백엔드: 127.0.0.1:3001 (hanjulDM api, 한줄AI 3000과 완전 독립)
# 프론트엔드 정적: /home/administrator/hanjuldm-app/packages/frontend/dist
# 슈퍼관리자 정적: /home/administrator/hanjuldm-app/packages/admin-frontend/dist
# ============================================================

# ============================================================
# 매장 사장님 (hanjul-flyer.kr)
# ============================================================
server {
    listen 80;
    listen [::]:80;
    server_name hanjul-flyer.kr www.hanjul-flyer.kr hanjul-flyer.com www.hanjul-flyer.com hanjul-flyer.co.kr www.hanjul-flyer.co.kr;

    # Let's Encrypt 자동 갱신 경로
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTPS 강제 리다이렉트
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hanjul-flyer.kr www.hanjul-flyer.kr hanjul-flyer.com www.hanjul-flyer.com hanjul-flyer.co.kr www.hanjul-flyer.co.kr;

    # SSL 인증서 (Let's Encrypt — Harold 발급)
    ssl_certificate /etc/letsencrypt/live/hanjul-flyer.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hanjul-flyer.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;

    # 보안 헤더
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # API 프록시 → hanjulDM backend (port 3001)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # 단축 URL 리라이트 — hanjul-flyer.kr/{code} → /api/flyer/p/{code}
    # 단, /api/, /assets/, /manual/ 등 예외
    location ~ ^/([A-Za-z0-9_-]+)$ {
        rewrite ^/([A-Za-z0-9_-]+)$ /api/flyer/p/$1 last;
    }

    # 프론트엔드 정적 (Vite SPA)
    # SPA cache 정책 (D145 nginx 영구 박음 — index.html no-cache, assets 1년)
    location = /index.html {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }
    location ~ ^/assets/ {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================
# 슈퍼관리자 (admin.hanjuldm.kr)
# ============================================================
server {
    listen 80;
    listen [::]:80;
    server_name admin.hanjuldm.kr sys.hanjuldm.kr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.hanjuldm.kr sys.hanjuldm.kr;

    ssl_certificate /etc/letsencrypt/live/admin.hanjuldm.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.hanjuldm.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API 프록시 → hanjulDM backend (same)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_scheme;
    }

    # 슈퍼관리자 정적 (Vite SPA)
    location = /index.html {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }
    location ~ ^/assets/ {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}
