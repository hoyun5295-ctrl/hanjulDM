# ============================================================
# hanjulDM nginx site config (기존 3 도메인 활용 + sys.hanjul-flyer.co.kr subdomain)
# 분리: 2026-05-12 (D152)
# 정정 2: 2026-05-13 (D153) — hanjul-flyer.com을 매장 사장님으로 환원 (사용자 노출 URL 유지),
#                              슈퍼관리자는 sys.hanjul-flyer.co.kr subdomain 신규
# ============================================================
# 도메인 매핑:
#   매장 사장님 (packages/frontend/dist):
#     - hanjul-flyer.kr / www
#     - hanjul-flyer.com / www
#     - hanjul-flyer.co.kr / www
#   슈퍼관리자 (packages/admin-frontend/dist):
#     - sys.hanjul-flyer.co.kr (subdomain 신규, Harold DNS 콘솔에서 A 레코드 박음)
# ============================================================
# SSL:
#   - 매장 사장님: /etc/letsencrypt/live/hanjul-flyer.com/ (SAN 6 도메인 포함, 만료 Jun 27 2026)
#   - 슈퍼관리자: /etc/letsencrypt/live/sys.hanjul-flyer.co.kr/ (Phase 4-2에서 certbot --webroot 발급)
# 백엔드: 127.0.0.1:3001 (hanjulDM api)
# ============================================================

# ============================================================
# 매장 사장님 — hanjul-flyer.kr/.com/.co.kr × www (6 도메인)
# ============================================================
server {
    listen 80;
    listen [::]:80;
    server_name hanjul-flyer.kr www.hanjul-flyer.kr hanjul-flyer.com www.hanjul-flyer.com hanjul-flyer.co.kr www.hanjul-flyer.co.kr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hanjul-flyer.kr www.hanjul-flyer.kr hanjul-flyer.com www.hanjul-flyer.com hanjul-flyer.co.kr www.hanjul-flyer.co.kr;

    ssl_certificate /etc/letsencrypt/live/hanjul-flyer.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hanjul-flyer.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # API → hanjulDM backend (port 3001)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # 단축 URL — hanjul-flyer.kr/{code} → /api/flyer/p/{code}
    location ~ ^/([A-Za-z0-9_-]+)$ {
        rewrite ^/([A-Za-z0-9_-]+)$ /api/flyer/p/$1 last;
    }

    # 매장 사장님 정적 (Vite SPA — D145 SPA cache 정책)
    location = /index.html {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }
    location ~ ^/assets/ {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        root /home/administrator/hanjuldm-app/packages/frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================
# 슈퍼관리자 — sys.hanjul-flyer.co.kr (subdomain)
# ============================================================
server {
    listen 80;
    listen [::]:80;
    server_name sys.hanjul-flyer.co.kr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sys.hanjul-flyer.co.kr;

    ssl_certificate /etc/letsencrypt/live/sys.hanjul-flyer.co.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sys.hanjul-flyer.co.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # API → hanjulDM backend (port 3001, 매장 사장님과 동일)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 슈퍼관리자 정적 (Vite SPA — D145 SPA cache 정책)
    location = /index.html {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }
    location ~ ^/assets/ {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        root /home/administrator/hanjuldm-app/packages/admin-frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}
