# hanjulDM 환경변수 (port 3001, 한줄AI 3000과 완전 분리)
# 분리 시점: 2026-05-12
# 한줄AI와 같은 DB·QTmsg·IMC 인스턴스를 사용하되 hanjulDM 영역만 호출

# ===========================================
# Database (한줄AI와 같은 PG 인스턴스, flyer_* 테이블 영역만 접근)
# ===========================================
DATABASE_URL=postgresql://targetup:PASSWORD@localhost:5432/targetup

# ===========================================
# QTmsg MySQL (한줄AI와 같은 인스턴스, SMSQ_SEND 라인 공유)
# ===========================================
QTMSG_DB_HOST=
QTMSG_DB_PORT=3306
QTMSG_DB_USER=
QTMSG_DB_PASSWORD=
QTMSG_DB_NAME=

# ===========================================
# JWT 인증 (hanjulDM 자체 시크릿 — 한줄AI와 다른 값 권장)
# ===========================================
JWT_SECRET=your-hanjuldm-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ===========================================
# 서버 설정
# ===========================================
PORT=3001
NODE_ENV=production

# ===========================================
# Claude API (CT-F16 POS 스키마 분석, AI 카피, 카테고리 분류)
# ===========================================
ANTHROPIC_API_KEY=

# ===========================================
# OpenAI (Claude fallback)
# ===========================================
OPENAI_API_KEY=

# ===========================================
# 네이버 쇼핑 (상품 이미지 자동 매칭 — CT-F17)
# ===========================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===========================================
# 휴머스온 IMC (한줄AI와 같은 API 키, hanjulDM 회사 발신프로필만 호출)
# ===========================================
IMC_ENV=PRD
IMC_API_KEY=
IMC_BASE_URL_PRD=https://imc-api.humuson.com
IMC_BASE_URL_STG=http://10.147.1.109:28000
IMC_WEBHOOK_ALLOWED_IPS=
IMC_WEBHOOK_HMAC_SECRET=
IMC_UPLOAD_TMP_DIR=/tmp/imc-uploads-hanjuldm

# ===========================================
# 080 수신거부
# ===========================================
OPT_OUT_API_URL=
OPT_OUT_API_KEY=

# ===========================================
# 파일 업로드
# ===========================================
UPLOAD_MAX_SIZE=45000
UPLOAD_PATH=./uploads

# ===========================================
# CORS — hanjulDM 도메인만 (한줄AI 도메인 제외)
# ===========================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://hanjul-flyer.kr,https://www.hanjul-flyer.kr,https://hanjul-flyer.com,https://www.hanjul-flyer.com,https://hanjul-flyer.co.kr,https://www.hanjul-flyer.co.kr,https://admin.hanjuldm.kr,https://sys.hanjuldm.kr
